DATABASE_URL="postgresql://ecrm:ecrm@localhost:54329/ecrm?schema=public"
# Metadata-only control-plane database. It must be distinct from every customer-cell database.
PLATFORM_DATABASE_URL="postgresql://ecrm:ecrm@localhost:54329/ecrm_platform?schema=public"
AUTH_SECRET="replace-with-at-least-32-characters-for-local-dev"
APP_BASE_URL="http://localhost:3000"
# Runtime mode: set to "platform" for the central control plane or "cell" for one customer cell.
APP_MODE=""
# Local control-plane administrator bearer token (minimum 32 characters). Never reuse AUTH_SECRET.
PLATFORM_ADMIN_TOKEN=""
# Identity bound to PLATFORM_ADMIN_TOKEN for audit attribution. Caller headers cannot override it.
PLATFORM_ADMIN_ACTOR=""
# Shared only by the platform projection signer and its matching customer cell. Minimum 32 characters.
CELL_CONTROL_PROJECTION_SECRET=""
# Shared only by the control plane token issuer and customer-cell verifier. Minimum 32 characters.
SUPPORT_ACCESS_SECRET=""
# Required only when APP_MODE="cell". Use deployment-specific, non-secret identifiers.
CELL_ID=""
CELL_KEY=""
# Development-only migration fallback. Production rejects this token even when set.
ALLOW_LEGACY_SHARED_DATA_TOKEN="false"
SHARED_DATA_API_TOKEN=""
INTEGRATION_DESTINATION_INSTALLATION="signalloop:workspace-key"
INTEGRATION_DESTINATION_URL="https://signalloop.example.com"
INTEGRATION_DESTINATION_TOKEN="replace-with-destination-service-token"
INTEGRATION_DELIVERY_MAX_ATTEMPTS="5"
INTEGRATION_DELIVERY_BASE_DELAY_MS="1000"
INTEGRATION_DELIVERY_MAX_DELAY_MS="300000"
INTEGRATION_DELIVERY_LEASE_MS="30000"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_SALES_EMAIL="sales@example.com"
SEED_SALES_PASSWORD="Sales@12345"
SALES_VOICE_STORAGE_DIR=".local-storage/sales-voice-notes"
BLOB_READ_WRITE_TOKEN=""
