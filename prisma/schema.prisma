generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  OFFBOARDING
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMIN
  SALES
  FINANCE
  PRODUCTION
  READ_ONLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum LeadState {
  LEAD
  CUSTOMER
  DORMANT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum SalesTaskStatus {
  OPEN
  COMPLETED
  CARRIED_FORWARD
  CANCELLED
}

enum SalesTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SalesTaskType {
  CALL
  EMAIL
  FOLLOW_UP
  SEND_MATERIAL
  MEETING
  CRM_UPDATE
  CUSTOM
}

enum SalesTaskSource {
  MANUAL
  VOICE_NOTE
  CARRY_FORWARD
  INSIGHT
  CRM
}

enum SalesVoiceNoteStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

enum SalesSuggestedActionStatus {
  DRAFT
  ACCEPTED
  REJECTED
}

enum SalesDayReviewItemStatus {
  DONE
  MOVE_TO_TOMORROW
  BLOCKED
  WAITING_ON_CUSTOMER
  CANCEL
}

enum PipelineStageKind {
  OPEN
  WON
  LOST
  DORMANT
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  DRAFT
  BOOKED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductionStageStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
  OTHER
}

enum CostComponentStatus {
  DRAFT
  APPROVED
  REJECTED
  VOID
}

enum IncentiveStatus {
  NOT_READY
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  PAID
  VOID
}

enum CurrencyCode {
  INR
  USD
}

enum SharedRecordType {
  LEAD
  CUSTOMER
  CONTACT
  OPPORTUNITY
  ORDER
}

model Organization {
  id               String             @id @default(cuid())
  key              String             @unique
  legalName        String
  displayName      String
  status           OrganizationStatus @default(PROVISIONING)
  deploymentRegion String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  version          Int                @default(1)

  memberships                     OrganizationMembership[]
  settings                        OrganizationSettings?
  branding                        OrganizationBranding?
  sharedBusinessRecords           SharedBusinessRecord[]
  sharedBusinessRecordVersions    SharedBusinessRecordVersion[]
  sharedRecordExportSnapshots     SharedRecordExportSnapshot[]
  sharedRecordExportSnapshotItems SharedRecordExportSnapshotItem[]
  workflowEvents                  WorkflowEvent[]
  leadCustomers                   LeadCustomer[]
  branches                        Branch[]
  contacts                        Contact[]
  activities                      Activity[]
  leadOwnershipHistory            LeadOwnershipHistory[]
  salesTasks                      SalesTask[]
  salesTextNotes                  SalesTextNote[]
  salesVoiceNotes                 SalesVoiceNote[]
  salesVoiceNoteActions           SalesVoiceNoteAction[]
  salesDayReviews                 SalesDayReview[]
  salesDayReviewItems             SalesDayReviewItem[]
  pipelineStages                  PipelineStage[]
  opportunities                   Opportunity[]
  opportunityOwnerSplits          OpportunityOwnerSplit[]
  salesTargets                    SalesTarget[]
  productServices                 ProductService[]
  proposals                       Proposal[]
  proposalLineItems               ProposalLineItem[]
  proposalPdfAttachments          ProposalPdfAttachment[]
  orders                          Order[]
  orderLineItems                  OrderLineItem[]
  orderOwnerSplitSnapshots        OrderOwnerSplitSnapshot[]
  productionTemplates             ProductionTemplate[]
  productionTemplateStages        ProductionTemplateStage[]
  productionWorkItems             ProductionWorkItem[]
  productionStageInstances        ProductionStageInstance[]
  productionNotes                 ProductionNote[]
  invoices                        Invoice[]
  payments                        Payment[]
  paymentAllocations              PaymentAllocation[]
  costComponents                  CostComponent[]
  incentives                      Incentive[]
  incentiveSplits                 IncentiveSplit[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model OrganizationSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  currency             CurrencyCode @default(USD)
  locale               String       @default("en")
  timezone             String       @default("UTC")
  defaultCountry       String?
  taxConfiguration     Json         @default("{}")
  invoiceConfiguration Json         @default("{}")
  paymentConfiguration Json         @default("{}")
  numberingRules       Json         @default("{}")
  retentionPolicy      Json         @default("{}")
  financialClosePolicy Json         @default("{}")
  enabledModules       Json         @default("[]")
  operationalLimits    Json         @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  version              Int          @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationBranding {
  id             String   @id @default(cuid())
  organizationId String   @unique
  productName    String   @default("eCRM")
  logoAssetId    String?
  imageAssetId   String?
  primaryColor   String   @default("#1F2937")
  secondaryColor String   @default("#6B7280")
  supportUrl     String?
  legalUrl       String?
  supportEmail   String?
  emailFromName  String   @default("eCRM")
  documentFooter String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessSettings {
  id              String       @id @default("default")
  defaultCurrency CurrencyCode @default(INR)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model SharedBusinessRecord {
  id                   String                        @id @default(cuid())
  organizationId       String?
  entityType           SharedRecordType
  displayName          String
  status               String
  ownerId              String?
  parentId             String?
  relatedLeadId        String?
  relatedCustomerId    String?
  relatedContactId     String?
  relatedOpportunityId String?
  sourceApp            String
  ecrmLegacyId         String?
  emailVoiceLegacyId   String?
  externalKey          String?
  email                String?
  phone                String?
  companyName          String?
  searchText           String
  headVersion          Int                           @default(1)
  lastChangedByApp     String?
  lastChangeAt         DateTime?
  data                 Json
  archivedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  versions             SharedBusinessRecordVersion[]
  organization         Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([entityType, ecrmLegacyId])
  @@unique([entityType, emailVoiceLegacyId])
  @@unique([entityType, externalKey])
  @@unique([organizationId, entityType, externalKey])
  @@index([organizationId])
  @@index([entityType, status])
  @@index([ownerId])
  @@index([parentId])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
  @@index([relatedContactId])
  @@index([relatedOpportunityId])
  @@index([email])
  @@index([phone])
  @@index([companyName])
  @@index([searchText])
  @@index([headVersion])
  @@index([updatedAt])
}

model SharedBusinessRecordVersion {
  id             String           @id @default(cuid())
  organizationId String?
  recordId       String
  versionNumber  Int
  entityType     SharedRecordType
  sourceApp      String
  changeType     String
  changedAt      DateTime         @default(now())
  actorId        String?
  idempotencyKey String?
  baseVersion    Int?
  snapshot       Json
  changedFields  Json?

  record       SharedBusinessRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([recordId, versionNumber])
  @@index([organizationId])
  @@index([entityType, changedAt])
  @@index([sourceApp, changedAt])
  @@index([idempotencyKey])
}

model SharedRecordExportSnapshot {
  id             String                           @id @default(cuid())
  organizationId String?
  entityType     SharedRecordType?
  itemCount      Int                              @default(0)
  createdAt      DateTime                         @default(now())
  expiresAt      DateTime
  items          SharedRecordExportSnapshotItem[]
  organization   Organization?                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([createdAt])
  @@index([expiresAt])
}

model SharedRecordExportSnapshotItem {
  snapshotId     String
  position       Int
  organizationId String?
  payload        Json

  snapshot     SharedRecordExportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([snapshotId, position])
  @@index([organizationId])
}

model WorkflowEvent {
  id                String        @id @default(cuid())
  organizationId    String?
  sourceApp         String
  sourceEventId     String?
  sourceEventType   String
  entityType        String
  entityId          String?
  relatedRecordType String?
  relatedRecordId   String?
  summary           String
  payload           Json
  occurredAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([sourceApp, sourceEventId])
  @@index([organizationId])
  @@index([sourceApp, occurredAt])
  @@index([entityType, entityId])
  @@index([relatedRecordType, relatedRecordId])
  @@index([sourceEventType, occurredAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeadCustomers          LeadCustomer[]            @relation("LeadOwner")
  createdLeadCustomers        LeadCustomer[]            @relation("LeadCreatedBy")
  updatedLeadCustomers        LeadCustomer[]            @relation("LeadUpdatedBy")
  ownedActivities             Activity[]                @relation("ActivityOwner")
  createdActivities           Activity[]                @relation("ActivityCreatedBy")
  completedActivities         Activity[]                @relation("ActivityCompletedBy")
  ownershipChangesFrom        LeadOwnershipHistory[]    @relation("LeadOwnershipFrom")
  ownershipChangesTo          LeadOwnershipHistory[]    @relation("LeadOwnershipTo")
  ownershipChangesChanged     LeadOwnershipHistory[]    @relation("LeadOwnershipChangedBy")
  ownedOpportunities          Opportunity[]             @relation("OpportunityOwner")
  createdOpportunities        Opportunity[]             @relation("OpportunityCreatedBy")
  updatedOpportunities        Opportunity[]             @relation("OpportunityUpdatedBy")
  opportunitySplits           OpportunityOwnerSplit[]
  salesTargets                SalesTarget[]             @relation("SalesTargetOwner")
  salesTargetsCreated         SalesTarget[]             @relation("SalesTargetCreatedBy")
  createdProductServices      ProductService[]          @relation("ProductServiceCreatedBy")
  updatedProductServices      ProductService[]          @relation("ProductServiceUpdatedBy")
  createdProposals            Proposal[]                @relation("ProposalCreatedBy")
  updatedProposals            Proposal[]                @relation("ProposalUpdatedBy")
  uploadedProposalPdfs        ProposalPdfAttachment[]   @relation("ProposalPdfUploadedBy")
  ownedOrders                 Order[]                   @relation("OrderOwner")
  createdOrders               Order[]                   @relation("OrderCreatedBy")
  updatedOrders               Order[]                   @relation("OrderUpdatedBy")
  orderSplitSnapshots         OrderOwnerSplitSnapshot[]
  assignedProductionWorkItems ProductionWorkItem[]      @relation("ProductionWorkItemAssignedTo")
  createdProductionWorkItems  ProductionWorkItem[]      @relation("ProductionWorkItemCreatedBy")
  updatedProductionWorkItems  ProductionWorkItem[]      @relation("ProductionWorkItemUpdatedBy")
  assignedProductionStages    ProductionStageInstance[] @relation("ProductionStageAssignedTo")
  completedProductionStages   ProductionStageInstance[] @relation("ProductionStageCompletedBy")
  createdProductionNotes      ProductionNote[]          @relation("ProductionNoteCreatedBy")
  createdInvoices             Invoice[]                 @relation("InvoiceCreatedBy")
  updatedInvoices             Invoice[]                 @relation("InvoiceUpdatedBy")
  voidedInvoices              Invoice[]                 @relation("InvoiceVoidedBy")
  createdPayments             Payment[]                 @relation("PaymentCreatedBy")
  createdCostComponents       CostComponent[]           @relation("CostComponentCreatedBy")
  updatedCostComponents       CostComponent[]           @relation("CostComponentUpdatedBy")
  approvedCostComponents      CostComponent[]           @relation("CostComponentApprovedBy")
  rejectedCostComponents      CostComponent[]           @relation("CostComponentRejectedBy")
  voidedCostComponents        CostComponent[]           @relation("CostComponentVoidedBy")
  approvedIncentives          Incentive[]               @relation("IncentiveApprovedBy")
  overriddenIncentives        Incentive[]               @relation("IncentiveOverrideBy")
  rejectedIncentives          Incentive[]               @relation("IncentiveRejectedBy")
  paidIncentives              Incentive[]               @relation("IncentivePaidBy")
  incentiveSplits             IncentiveSplit[]
  salesTasks                  SalesTask[]               @relation("SalesTaskOwner")
  salesTextNotes              SalesTextNote[]           @relation("SalesTextNoteOwner")
  salesVoiceNotes             SalesVoiceNote[]          @relation("SalesVoiceNoteOwner")
  salesDayReviews             SalesDayReview[]          @relation("SalesDayReviewOwner")
  memberships                 OrganizationMembership[]
}

model LeadCustomer {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  state          LeadState @default(LEAD)
  industry       String?
  source         String?
  ownerId        String
  notes          String?
  createdById    String
  updatedById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner            User                   @relation("LeadOwner", fields: [ownerId], references: [id])
  createdBy        User                   @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                   @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  branches         Branch[]
  contacts         Contact[]
  activities       Activity[]
  ownershipHistory LeadOwnershipHistory[]
  opportunities    Opportunity[]
  orders           Order[]
  salesTasks       SalesTask[]
  salesTextNotes   SalesTextNote[]
  salesVoiceNotes  SalesVoiceNote[]
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ownerId])
  @@index([state])
  @@index([name])
  @@index([createdAt])
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String?
  leadCustomerId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String   @default("India")
  gstin          String?
  locationHint   String?
  salesContext   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leadCustomer  LeadCustomer  @relation(fields: [leadCustomerId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  activities    Activity[]
  opportunities Opportunity[]
  orders        Order[]
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadCustomerId])
  @@index([city])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String?
  leadCustomerId String
  branchId       String?
  name           String
  designation    String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leadCustomer LeadCustomer  @relation(fields: [leadCustomerId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  activities   Activity[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadCustomerId])
  @@index([branchId])
  @@index([email])
  @@index([phone])
}

model Activity {
  id             String         @id @default(cuid())
  organizationId String?
  leadCustomerId String
  branchId       String?
  contactId      String?
  ownerId        String
  createdById    String
  completedById  String?
  type           ActivityType
  status         ActivityStatus @default(OPEN)
  subject        String
  body           String?
  occurredAt     DateTime?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leadCustomer LeadCustomer  @relation(fields: [leadCustomerId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User          @relation("ActivityOwner", fields: [ownerId], references: [id])
  createdBy    User          @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  completedBy  User?         @relation("ActivityCompletedBy", fields: [completedById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadCustomerId])
  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
  @@index([type])
}

model SalesTask {
  id                String            @id @default(cuid())
  organizationId    String?
  ownerId           String
  leadCustomerId    String?
  opportunityId     String?
  proposalId        String?
  orderId           String?
  title             String
  description       String?
  type              SalesTaskType
  priority          SalesTaskPriority @default(MEDIUM)
  status            SalesTaskStatus   @default(OPEN)
  source            SalesTaskSource   @default(MANUAL)
  dueAt             DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdFromNoteId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner            User                   @relation("SalesTaskOwner", fields: [ownerId], references: [id])
  leadCustomer     LeadCustomer?          @relation(fields: [leadCustomerId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal         Proposal?              @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  order            Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  voiceNotes       SalesVoiceNote[]
  textNotes        SalesTextNote[]
  suggestedActions SalesVoiceNoteAction[] @relation("CreatedSalesTaskFromAction")
  reviewItems      SalesDayReviewItem[]
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ownerId, dueAt])
  @@index([ownerId, status])
  @@index([leadCustomerId])
  @@index([opportunityId])
  @@index([proposalId])
  @@index([orderId])
}

model SalesTextNote {
  id             String   @id @default(cuid())
  organizationId String?
  ownerId        String
  taskId         String?
  leadCustomerId String?
  opportunityId  String?
  proposalId     String?
  orderId        String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User          @relation("SalesTextNoteOwner", fields: [ownerId], references: [id])
  task         SalesTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  leadCustomer LeadCustomer? @relation(fields: [leadCustomerId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal     Proposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ownerId, createdAt])
  @@index([taskId])
  @@index([leadCustomerId])
  @@index([opportunityId])
  @@index([proposalId])
  @@index([orderId])
}

model SalesVoiceNote {
  id               String               @id @default(cuid())
  organizationId   String?
  ownerId          String
  taskId           String?
  leadCustomerId   String?
  opportunityId    String?
  proposalId       String?
  orderId          String?
  audioStorageKey  String
  originalFileName String
  mimeType         String
  fileSizeBytes    Int
  durationSeconds  Int?
  status           SalesVoiceNoteStatus @default(UPLOADED)
  transcript       String?
  summary          String?
  customerAsk      String?
  nextStep         String?
  processingError  String?
  retainedUntil    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  owner        User                   @relation("SalesVoiceNoteOwner", fields: [ownerId], references: [id])
  task         SalesTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  leadCustomer LeadCustomer?          @relation(fields: [leadCustomerId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  proposal     Proposal?              @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actions      SalesVoiceNoteAction[]
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ownerId, createdAt])
  @@index([taskId])
  @@index([leadCustomerId])
  @@index([status])
}

model SalesVoiceNoteAction {
  id              String                     @id @default(cuid())
  organizationId  String?
  voiceNoteId     String
  createdTaskId   String?
  title           String
  description     String?
  type            SalesTaskType
  suggestedDueAt  DateTime?
  status          SalesSuggestedActionStatus @default(DRAFT)
  confidenceLabel String?
  createdAt       DateTime                   @default(now())
  acceptedAt      DateTime?
  rejectedAt      DateTime?

  voiceNote    SalesVoiceNote @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)
  createdTask  SalesTask?     @relation("CreatedSalesTaskFromAction", fields: [createdTaskId], references: [id], onDelete: SetNull)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([voiceNoteId])
  @@index([status])
}

model SalesDayReview {
  id             String   @id @default(cuid())
  organizationId String?
  ownerId        String
  reviewDate     DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User                 @relation("SalesDayReviewOwner", fields: [ownerId], references: [id])
  items        SalesDayReviewItem[]
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([ownerId, reviewDate])
  @@index([organizationId])
  @@index([ownerId, reviewDate])
}

model SalesDayReviewItem {
  id             String                   @id @default(cuid())
  organizationId String?
  reviewId       String
  taskId         String
  status         SalesDayReviewItemStatus
  note           String?
  createdAt      DateTime                 @default(now())

  review       SalesDayReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  task         SalesTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([reviewId, taskId])
  @@index([organizationId])
  @@index([taskId])
}

model LeadOwnershipHistory {
  id             String   @id @default(cuid())
  organizationId String?
  leadCustomerId String
  fromOwnerId    String?
  toOwnerId      String
  changedById    String
  reason         String
  createdAt      DateTime @default(now())

  leadCustomer LeadCustomer  @relation(fields: [leadCustomerId], references: [id], onDelete: Cascade)
  fromOwner    User?         @relation("LeadOwnershipFrom", fields: [fromOwnerId], references: [id])
  toOwner      User          @relation("LeadOwnershipTo", fields: [toOwnerId], references: [id])
  changedBy    User          @relation("LeadOwnershipChangedBy", fields: [changedById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadCustomerId])
  @@index([toOwnerId])
  @@index([createdAt])
}

model PipelineStage {
  id             String            @id @default(cuid())
  organizationId String?
  name           String            @unique
  sortOrder      Int
  kind           PipelineStageKind @default(OPEN)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  opportunities Opportunity[]
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([sortOrder])
  @@index([kind])
}

model Opportunity {
  id                String    @id @default(cuid())
  organizationId    String?
  leadCustomerId    String
  branchId          String?
  stageId           String
  ownerId           String
  title             String
  productInterest   String?
  estimatedValueInr Decimal?  @db.Decimal(14, 2)
  probability       Int?
  lastReachAt       DateTime?
  nextFollowUpAt    DateTime?
  notes             String?
  createdById       String
  updatedById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leadCustomer    LeadCustomer            @relation(fields: [leadCustomerId], references: [id], onDelete: Cascade)
  branch          Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stage           PipelineStage           @relation(fields: [stageId], references: [id])
  owner           User                    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdBy       User                    @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy       User                    @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id])
  splits          OpportunityOwnerSplit[]
  proposals       Proposal[]
  orders          Order[]
  salesTasks      SalesTask[]
  salesTextNotes  SalesTextNote[]
  salesVoiceNotes SalesVoiceNote[]
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadCustomerId])
  @@index([branchId])
  @@index([stageId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([updatedAt])
}

model OpportunityOwnerSplit {
  opportunityId  String
  userId         String
  organizationId String?
  percent        Int

  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([opportunityId, userId])
  @@index([organizationId])
  @@index([userId])
}

model SalesTarget {
  id             String   @id @default(cuid())
  organizationId String?
  ownerId        String
  financialYear  Int
  quarter        Int
  targetValueInr Decimal  @db.Decimal(14, 2)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User          @relation("SalesTargetOwner", fields: [ownerId], references: [id])
  createdBy    User          @relation("SalesTargetCreatedBy", fields: [createdById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([ownerId, financialYear, quarter])
  @@index([organizationId])
  @@index([financialYear, quarter])
}

model ProductService {
  id                           String   @id @default(cuid())
  organizationId               String?
  name                         String
  code                         String?  @unique
  category                     String
  description                  String?
  defaultGstRateBps            Int      @default(1800)
  defaultProductionTemplateKey String?
  active                       Boolean  @default(true)
  sortOrder                    Int      @default(0)
  createdById                  String
  updatedById                  String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  createdBy         User               @relation("ProductServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy         User               @relation("ProductServiceUpdatedBy", fields: [updatedById], references: [id])
  proposalLineItems ProposalLineItem[]
  orderLineItems    OrderLineItem[]
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([active, sortOrder])
  @@index([category])
  @@index([name])
}

model Proposal {
  id                String         @id @default(cuid())
  organizationId    String?
  opportunityId     String
  title             String
  sequenceNumber    Int
  versionLabel      String?
  status            ProposalStatus @default(DRAFT)
  currency          String         @default("INR")
  validUntil        DateTime?
  commercialSummary String?
  assumptions       String?
  inclusions        String?
  exclusions        String?
  paymentTerms      String?
  deliveryTimeline  String?
  internalNotes     String?
  subtotalPaisa     Int            @default(0)
  gstPaisa          Int            @default(0)
  totalPaisa        Int            @default(0)
  createdById       String
  updatedById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  opportunity     Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy       User                    @relation("ProposalUpdatedBy", fields: [updatedById], references: [id])
  lineItems       ProposalLineItem[]
  pdfAttachments  ProposalPdfAttachment[]
  order           Order?
  salesTasks      SalesTask[]
  salesTextNotes  SalesTextNote[]
  salesVoiceNotes SalesVoiceNote[]
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, sequenceNumber])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
}

model ProposalLineItem {
  id                      String   @id @default(cuid())
  organizationId          String?
  proposalId              String
  productServiceId        String
  productNameSnapshot     String
  productCategorySnapshot String
  description             String?
  quantity                Int
  unitPricePaisa          Int
  gstRateBps              Int
  gstOverrideReason       String?
  lineSubtotalPaisa       Int
  lineGstPaisa            Int
  lineTotalPaisa          Int
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  proposal       Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id])
  orderLineItem  OrderLineItem?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([proposalId])
  @@index([productServiceId])
}

model ProposalPdfAttachment {
  id               String    @id @default(cuid())
  organizationId   String?
  proposalId       String
  originalFileName String
  storedFileName   String
  storageProvider  String
  storageKey       String
  mimeType         String
  fileSizeBytes    Int
  sha256           String?
  canvaDesignUrl   String?
  uploadedById     String
  uploadedAt       DateTime  @default(now())
  replacedAt       DateTime?

  proposal     Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("ProposalPdfUploadedBy", fields: [uploadedById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([proposalId])
  @@index([uploadedAt])
}

model Order {
  id              String      @id @default(cuid())
  organizationId  String?
  orderNumber     String      @unique
  proposalId      String      @unique
  opportunityId   String
  leadCustomerId  String
  branchId        String?
  ownerId         String
  status          OrderStatus @default(BOOKED)
  poNumber        String?
  poDate          DateTime?
  poFileName      String?
  poStorageKey    String?
  poFileSizeBytes Int?
  poMimeType      String?
  bookedAt        DateTime    @default(now())
  deliveryDueAt   DateTime?
  currency        String      @default("INR")
  subtotalPaisa   Int
  gstPaisa        Int
  totalPaisa      Int
  createdById     String
  updatedById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  proposal        Proposal                  @relation(fields: [proposalId], references: [id])
  opportunity     Opportunity               @relation(fields: [opportunityId], references: [id])
  leadCustomer    LeadCustomer              @relation(fields: [leadCustomerId], references: [id])
  branch          Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner           User                      @relation("OrderOwner", fields: [ownerId], references: [id])
  createdBy       User                      @relation("OrderCreatedBy", fields: [createdById], references: [id])
  updatedBy       User                      @relation("OrderUpdatedBy", fields: [updatedById], references: [id])
  lineItems       OrderLineItem[]
  splitSnapshots  OrderOwnerSplitSnapshot[]
  invoices        Invoice[]
  payments        Payment[]
  costComponents  CostComponent[]
  incentive       Incentive?
  salesTasks      SalesTask[]
  salesTextNotes  SalesTextNote[]
  salesVoiceNotes SalesVoiceNote[]
  organization    Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@index([ownerId])
  @@index([leadCustomerId])
  @@index([opportunityId])
  @@index([bookedAt])
  @@index([deliveryDueAt])
}

model OrderLineItem {
  id                            String   @id @default(cuid())
  organizationId                String?
  orderId                       String
  proposalLineItemId            String   @unique
  productServiceId              String?
  productNameSnapshot           String
  productCategorySnapshot       String
  productionTemplateKeySnapshot String?
  description                   String?
  quantity                      Int
  unitPricePaisa                Int
  gstRateBps                    Int
  gstOverrideReason             String?
  lineSubtotalPaisa             Int
  lineGstPaisa                  Int
  lineTotalPaisa                Int
  sortOrder                     Int      @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposalLineItem    ProposalLineItem     @relation(fields: [proposalLineItemId], references: [id])
  productService      ProductService?      @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  productionWorkItems ProductionWorkItem[]
  costComponents      CostComponent[]
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderId])
  @@index([productServiceId])
  @@index([productCategorySnapshot])
}

model OrderOwnerSplitSnapshot {
  orderId        String
  userId         String
  organizationId String?
  percent        Int

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([orderId, userId])
  @@index([organizationId])
  @@index([userId])
}

model ProductionTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  key            String   @unique
  name           String
  description    String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages       ProductionTemplateStage[]
  workItems    ProductionWorkItem[]
  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([active, sortOrder])
}

model ProductionTemplateStage {
  id                  String   @id @default(cuid())
  organizationId      String?
  templateId          String
  key                 String
  name                String
  description         String?
  required            Boolean  @default(true)
  defaultDurationDays Int?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  template       ProductionTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageInstances ProductionStageInstance[]
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([templateId, key])
  @@index([organizationId])
  @@index([templateId, sortOrder])
}

model ProductionWorkItem {
  id                      String                @id @default(cuid())
  organizationId          String?
  orderLineItemId         String
  productionTemplateId    String?
  title                   String
  productNameSnapshot     String
  productCategorySnapshot String
  status                  ProductionStageStatus @default(NOT_STARTED)
  assignedToId            String?
  dueAt                   DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdById             String
  updatedById             String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  orderLineItem      OrderLineItem             @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)
  productionTemplate ProductionTemplate?       @relation(fields: [productionTemplateId], references: [id], onDelete: SetNull)
  assignedTo         User?                     @relation("ProductionWorkItemAssignedTo", fields: [assignedToId], references: [id])
  createdBy          User                      @relation("ProductionWorkItemCreatedBy", fields: [createdById], references: [id])
  updatedBy          User                      @relation("ProductionWorkItemUpdatedBy", fields: [updatedById], references: [id])
  stageInstances     ProductionStageInstance[]
  notes              ProductionNote[]
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderLineItemId])
  @@index([productionTemplateId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([productCategorySnapshot])
}

model ProductionStageInstance {
  id              String                @id @default(cuid())
  organizationId  String?
  workItemId      String
  templateStageId String?
  name            String
  description     String?
  status          ProductionStageStatus @default(NOT_STARTED)
  required        Boolean               @default(true)
  sortOrder       Int                   @default(0)
  assignedToId    String?
  dueAt           DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  completedById   String?
  skippedReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workItem      ProductionWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  templateStage ProductionTemplateStage? @relation(fields: [templateStageId], references: [id], onDelete: SetNull)
  assignedTo    User?                    @relation("ProductionStageAssignedTo", fields: [assignedToId], references: [id])
  completedBy   User?                    @relation("ProductionStageCompletedBy", fields: [completedById], references: [id])
  notes         ProductionNote[]
  organization  Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([workItemId])
  @@index([templateStageId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueAt])
}

model ProductionNote {
  id              String   @id @default(cuid())
  organizationId  String?
  workItemId      String
  stageInstanceId String?
  body            String
  createdById     String
  createdAt       DateTime @default(now())

  workItem      ProductionWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  stageInstance ProductionStageInstance? @relation(fields: [stageInstanceId], references: [id], onDelete: SetNull)
  createdBy     User                     @relation("ProductionNoteCreatedBy", fields: [createdById], references: [id])
  organization  Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([workItemId])
  @@index([stageInstanceId])
  @@index([createdById])
  @@index([createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String?
  orderId        String
  invoiceNumber  String        @unique
  invoiceDate    DateTime
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  subtotalPaisa  Int
  gstPaisa       Int
  totalPaisa     Int
  notes          String?
  createdById    String
  updatedById    String
  voidedById     String?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy    User                @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  voidedBy     User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  allocations  PaymentAllocation[]
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
}

model Payment {
  id             String      @id @default(cuid())
  organizationId String?
  orderId        String
  paymentDate    DateTime
  amountPaisa    Int
  mode           PaymentMode
  reference      String?
  notes          String?
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  allocations  PaymentAllocation[]
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderId])
  @@index([paymentDate])
  @@index([mode])
}

model PaymentAllocation {
  id             String   @id @default(cuid())
  organizationId String?
  paymentId      String
  invoiceId      String
  amountPaisa    Int
  createdAt      DateTime @default(now())

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organizationId])
  @@index([invoiceId])
}

model CostComponent {
  id              String              @id @default(cuid())
  organizationId  String?
  orderId         String
  orderLineItemId String?
  category        String
  description     String
  amountPaisa     Int
  status          CostComponentStatus @default(DRAFT)
  createdById     String
  updatedById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineItem OrderLineItem? @relation(fields: [orderLineItemId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("CostComponentCreatedBy", fields: [createdById], references: [id])
  updatedBy     User           @relation("CostComponentUpdatedBy", fields: [updatedById], references: [id])
  approvedBy    User?          @relation("CostComponentApprovedBy", fields: [approvedById], references: [id])
  rejectedBy    User?          @relation("CostComponentRejectedBy", fields: [rejectedById], references: [id])
  voidedBy      User?          @relation("CostComponentVoidedBy", fields: [voidedById], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderId])
  @@index([orderLineItemId])
  @@index([status])
  @@index([category])
}

model Incentive {
  id                     String          @id @default(cuid())
  organizationId         String?
  orderId                String          @unique
  grossMarginPaisa       Int
  approvedCostTotalPaisa Int
  rateBps                Int             @default(500)
  calculatedAmountPaisa  Int
  overrideAmountPaisa    Int?
  payableAmountPaisa     Int
  status                 IncentiveStatus @default(NOT_READY)
  readinessReason        String?
  approvedById           String?
  approvedAt             DateTime?
  overrideById           String?
  overrideAt             DateTime?
  overrideReason         String?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  paidById               String?
  paidAt                 DateTime?
  paymentReference       String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approvedBy   User?            @relation("IncentiveApprovedBy", fields: [approvedById], references: [id])
  overrideBy   User?            @relation("IncentiveOverrideBy", fields: [overrideById], references: [id])
  rejectedBy   User?            @relation("IncentiveRejectedBy", fields: [rejectedById], references: [id])
  paidBy       User?            @relation("IncentivePaidBy", fields: [paidById], references: [id])
  splits       IncentiveSplit[]
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@index([approvedById])
}

model IncentiveSplit {
  incentiveId    String
  userId         String
  organizationId String?
  percent        Int
  amountPaisa    Int

  incentive    Incentive     @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([incentiveId, userId])
  @@index([organizationId])
  @@index([userId])
}
